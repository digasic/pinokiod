<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title>Pinokio</title>
  <style>
    :root {
      --layout-gutter-size: 6px;
      --layout-background: #ffffff;
      --layout-gutter-bg: rgba(0, 0, 0, 0.04);
      --layout-gutter-bg-hover: cornflowerblue;
      --layout-dragger-bg: var(--layout-background);
      --layout-dragger-border: rgba(15, 23, 42, 0.06);
      --layout-shadow: rgba(0, 0, 0, 0.06);
      --vault-notice-surface: #ffffff;
      --vault-notice-border: #dedfe2;
      --vault-notice-text: #202124;
      --vault-notice-muted: #666a70;
      --vault-notice-button: #f2f3f4;
      --vault-notice-button-hover: #e8e9eb;
      --vault-notice-focus: #3f6fc4;
      --layout-viewport-height: 100vh;
      --layout-dragger-height: 0px;
      color-scheme: light dark;
    }

    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: var(--layout-background);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    }

    #dragger {
      -webkit-app-region: drag;
      cursor: grab;
      display: none;
      height: 32px;
      width: 100%;
      box-sizing: border-box;
      background: var(--layout-dragger-bg);
    }
    body.dark > #dragger {
      background: var(--layout-dragger-bg);
    }

    body[data-agent="electron"] {
      --layout-dragger-height: 32px;
    }

    body[data-agent="electron"] > #dragger {
      display: block;
    }

    body.dark {
      --layout-background: #1b1c1d;
      --layout-dragger-bg: var(--layout-background);
      --layout-gutter-bg: rgba(255, 255, 255, 0.04);
      --layout-dragger-border: rgba(255, 255, 255, 0.055);
      /*
      --layout-background: #101010;
      --layout-gutter-bg: #101010;
      */
      --layout-gutter-bg-hover: cornflowerblue;
      --layout-shadow: rgba(0, 0, 0, 0.35);
      --vault-notice-surface: #252627;
      --vault-notice-border: #3c3e41;
      --vault-notice-text: #f1f2f3;
      --vault-notice-muted: #b3b6ba;
      --vault-notice-button: #343638;
      --vault-notice-button-hover: #404245;
      --vault-notice-focus: #8bb4ff;
      color: #f3f3f3;
    }

    #layout-root {
      position: relative;
      width: 100%;
      height: calc(100% - var(--layout-dragger-height, 0px));
      background: var(--layout-background);
      overflow: hidden;
    }

    .layout-leaf {
      background: var(--layout-background);
      position: absolute;
      box-sizing: border-box;
      /*
      box-shadow: inset 0 0 0 1px var(--layout-shadow);
      */
      overflow: hidden;
    }

    .layout-leaf iframe {
      width: 100%;
      height: 100%;
      border: none;
      background: transparent;
      display: block;
    }

    .layout-gutter {
      position: absolute;
      background: var(--layout-gutter-bg);
      z-index: 10;
      transition: background 0.15s ease;
    }

    .layout-gutter:hover {
      background: var(--layout-gutter-bg-hover);
    }

    .layout-gutter-columns {
      cursor: col-resize;
    }

    .layout-gutter-rows {
      cursor: row-resize;
    }

    body.layout-resizing {
      user-select: none;
    }

    body.layout-resize-columns {
      cursor: col-resize;
    }

    body.layout-resize-rows {
      cursor: row-resize;
    }

    body.layout-resizing iframe {
      pointer-events: none;
    }

    #vault-auto-scan-tray {
      position: fixed;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      z-index: 1000;
      display: grid;
      width: min(360px, calc(100vw - 32px));
      max-height: min(50vh, 420px);
      gap: 8px;
      overflow: auto;
      overscroll-behavior: contain;
      pointer-events: none;
      scrollbar-width: thin;
    }

    #vault-auto-scan-tray[hidden] {
      display: none;
    }

    .vault-auto-scan-row {
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      min-height: 52px;
      padding: 8px 8px 8px 12px;
      box-sizing: border-box;
      overflow: hidden;
      color: var(--vault-notice-text);
      background: var(--vault-notice-surface);
      border: 1px solid var(--vault-notice-border);
      border-radius: 10px;
      box-shadow: 0 8px 24px var(--layout-shadow);
      pointer-events: auto;
      animation: vault-notice-enter 180ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .vault-auto-scan-icon {
      display: grid;
      place-items: center;
      width: 20px;
      height: 20px;
      color: var(--vault-notice-muted);
    }

    .vault-auto-scan-icon svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .vault-auto-scan-row[data-state="checking"] .vault-auto-scan-icon {
      border: 1.5px solid var(--vault-notice-border);
      border-top-color: var(--vault-notice-text);
      border-radius: 50%;
      box-sizing: border-box;
      animation: vault-notice-spin 900ms linear infinite;
    }

    .vault-auto-scan-copy {
      min-width: 0;
      font-size: 13px;
      font-weight: 500;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .vault-auto-scan-action {
      position: relative;
      min-width: 58px;
      min-height: 34px;
      padding: 6px 10px;
      color: var(--vault-notice-text);
      background: var(--vault-notice-button);
      border: 1px solid var(--vault-notice-border);
      border-radius: 7px;
      font: 600 12px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      cursor: pointer;
      transition: background 120ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 120ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .vault-auto-scan-action:hover {
      background: var(--vault-notice-button-hover);
    }

    .vault-auto-scan-action:active {
      transform: translateY(1px);
    }

    .vault-auto-scan-action:focus-visible {
      outline: 2px solid var(--vault-notice-focus);
      outline-offset: 2px;
    }

    .vault-auto-scan-action:disabled {
      cursor: wait;
      opacity: 0.55;
    }

    @keyframes vault-notice-enter {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes vault-notice-spin {
      to { transform: rotate(360deg); }
    }

    @media (pointer: coarse) {
      .vault-auto-scan-action {
        min-height: 44px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .vault-auto-scan-row {
        animation: none;
      }
      .vault-auto-scan-row[data-state="checking"] .vault-auto-scan-icon {
        animation-duration: 1800ms;
      }
    }
  </style>
  <script>
    (function () {
      const root = document.documentElement;
      let lastViewportHeight = null;
      const updateViewportHeight = () => {
        const viewport = window.visualViewport;
        const height = viewport ? viewport.height : window.innerHeight;
        if (!height || !Number.isFinite(height)) {
          return;
        }
        const clampedHeight = Math.max(0, height);
        const roundedHeight = Number(clampedHeight.toFixed(2));
        if (lastViewportHeight === roundedHeight) {
          return;
        }
        lastViewportHeight = roundedHeight;
        root.style.setProperty('--layout-viewport-height', `${roundedHeight}px`);
        window.dispatchEvent(new CustomEvent('pinokio:viewport-change', {
          detail: { height: roundedHeight },
        }));
      };

      const resizeEvents = ['resize', 'orientationchange'];
      const boundUpdate = () => requestAnimationFrame(updateViewportHeight);

      updateViewportHeight();

      resizeEvents.forEach((eventName) => {
        window.addEventListener(eventName, boundUpdate, { passive: true });
      });
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', boundUpdate, { passive: true });
        window.visualViewport.addEventListener('scroll', boundUpdate, { passive: true });
      }

      window.addEventListener('pageshow', boundUpdate, { passive: true });
    })();
  </script>
</head>
<body class="<%= theme %>" data-agent="<%= agent %>">
  <div id='dragger'></div>
  <div id="layout-root"></div>
  <aside id="vault-auto-scan-tray" aria-label="Disk Saver notifications" aria-live="polite" hidden></aside>
  <script id="pinokio-layout-config" type="application/json">
    <%- JSON.stringify({
      initialPath: initialPath,
      defaultPath: defaultPath,
      sessionId: sessionId || null,
      vaultEnabled: typeof vaultEnabled === "undefined" ? true : !!vaultEnabled
    }) %>
  </script>
  <script src="/Socket.js"></script>
  <script src="/common.js"></script>
  <script src="/layout.js"></script>
</body>
</html>
